  "/v1/stress/run": {
   "post": {
    "tags": [
     "handlers"
    ],
    "summary": "`POST /v1/stress/run` \u2014 run a scenario's shocks against a\npoint-in-time snapshot (on-demand full recompute; never touches the\nincremental hot path). Idempotent per (scenario, snapshot ref).",
    "operationId": "run_stress",
    "requestBody": {
     "content": {
      "application/json": {
       "schema": {
        "$ref": "#/components/schemas/StressRunRequest"
       }
      }
