   "post": {
    "tags": [
     "handlers"
    ],
    "summary": "`POST /v1/limits` \u2014 upsert a limit threshold (admin-scoped;\nidempotent per (env, limit_type)). The limit_type must be one of the\nschema's CHECK values.",
    "operationId": "upsert_limit",
    "requestBody": {
     "content": {
      "application/json": {
       "schema": {
        "$ref": "#/components/schemas/UpsertLimitRequest"
