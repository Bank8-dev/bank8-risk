  "/v1/health": {
   "get": {
    "tags": [
     "meta"
    ],
    "summary": "`GET /v1/health` \u2014 service health payload.",
    "description": "Carries the binary's build identity (`version`/`build`, BUILDID-1) so\ncaptain's monitor populates `make status`'s VERSION column for every\ninstance \u2014 the consuming BINARY's identity, never a shared crate's.",
    "operationId": "health",
    "responses": {
     "200": {
      "description": "Liveness (version, build)"
     }
    },
    "security": []
   }
  },
  "/v1/limits": {
   "get": {
    "tags": [
     "handlers"
    ],
    "summary": "`GET /v1/limits` \u2014 list configured limits with breach state.",
    "operationId": "list_limits",
